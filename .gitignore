# ---------------------------------------------------------------------------
# sublime-rea — .gitignore
# Ignora apenas artefatos gerados/baixados. NÃO ignora bin/, docs/ nem setup/.
# ---------------------------------------------------------------------------

# --- alvo extraído / build ---
target/
build/
!build/icon.*
dist/
*.o
*.so
*.class

# --- tarball do alvo (Sublime Text build 4215): baixado SOB DEMANDA pelo setup.py
#     (URL + SHA-256 pinados em setup/versions.env). NÃO versionar (>20 MB). O
#     `bin/` NÃO é ignorado por inteiro: bin/ghidra-preanalyze.sh segue versionado.
bin/sublime_text_build_4215_x64.tar.xz
bin/sublime-text_build-4215_amd64.deb

# --- ferramentas baixadas (ex.: se REA_TOOLS_DIR apontar para dentro do repo) ---
tools/

# --- artefatos do Ghidra ---
ghidra_*/
ghidra_*_PUBLIC/
ghidra_*.zip
*.part
*.gpr
*.rep/
*.gzf
*.ghidra
*.lock

# --- ambiente específico da máquina (gerado) ---
.env
setup/env.sh

# --- node ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- IDE / editor ---
.idea/
.vscode/

# --- misc ---
*.log
.DS_Store

# Cache do LSP Serena
.serena/
