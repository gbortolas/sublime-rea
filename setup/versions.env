# versions.env — versões, URLs e checksums PINADOS do ambiente sublime-rea.
#
# Este arquivo é "sourceable" pelo setup.sh (bash): cada linha é KEY="value".
# NÃO coloque segredos aqui — é versionado no repositório.
#
# Fontes dos pins:
#   - REA        : npm `rea-agents` (https://www.npmjs.com/package/rea-agents)
#   - Ghidra     : release oficial NSA (github.com/NationalSecurityAgency/ghidra)
#   - Sublime    : bundle local em bin/ (build 4215)

# ---------------------------------------------------------------------------
# REA (pacote npm `rea-agents`) — cliente MCP de reverse engineering.
# ---------------------------------------------------------------------------
REA_PACKAGE="rea-agents"
REA_VERSION="6.5.0"

# ---------------------------------------------------------------------------
# Provider offline `pwntools-elf` do REA — usado por `inspect_binary_layout`.
#   * O REA NUNCA instala Python/pacotes: ele exige um interpretador apontado por
#     `REA_PWNTOOLS_PYTHON` com EXATAMENTE estas versões (mensagem do provider):
#       pwntools 4.15.0, pyelftools 0.33, Unicorn 2.1.2.
#   * O setup.py cria um venv dedicado em `$REA_TOOLS_DIR/<dir>` e instala os
#     três pacotes PINADOS, exportando `REA_PWNTOOLS_PYTHON=<venv>/bin/python`.
#   * `REA_PWNTOOLS_VENV_DIRNAME` é o nome do subdiretório do venv (default).
#   * `GET_PIP_URL`: bootstrapper oficial usado como fallback quando o Python do
#     sistema não tem `ensurepip` (ex.: falta python3-venv) — evita sudo.
# ---------------------------------------------------------------------------
PWNTOOLS_VERSION="4.15.0"
PYELFTOOLS_VERSION="0.33"
UNICORN_VERSION="2.1.2"
# Unicorn 2.1.2 importa `pkg_resources`, removido do setuptools >= 81.
SETUPTOOLS_VERSION="80.9.0"
REA_PWNTOOLS_VENV_DIRNAME="pwntools-venv"
GET_PIP_URL="https://bootstrap.pypa.io/get-pip.py"

# ---------------------------------------------------------------------------
# Ghidra — provider de análise profunda usado pelo REA.
#   * Versão exigida pelo REA: 12.1.x  → pin 12.1.4.
#   * JDK mínimo: 21 (Ghidra 12.2 subiu para 25; NÃO confundir).
#   * O zip oficial extrai para `ghidra_<versao>_PUBLIC/`.
# ---------------------------------------------------------------------------
GHIDRA_VERSION="12.1.4"
GHIDRA_BUILD_DATE="20260921"            # sufixo de build no nome do asset (YYYYMMDD)
GHIDRA_URL="https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip"
GHIDRA_ZIP_SHA256="ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db"
GHIDRA_ZIP_SIZE_BYTES="569649598"       # ~543 MiB (informativo)
GHIDRA_ZIP_FILENAME="ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_BUILD_DATE}.zip"
GHIDRA_EXTRACTED_DIRNAME="ghidra_${GHIDRA_VERSION}_PUBLIC"

# JDK mínimo exigido pelo Ghidra 12.1.x (ver docs/… "Getting Started" / "What's New").
# Fonte: https://ghidradocs.com/12.1_PUBLIC/GettingStarted.html
#        "IMPORTANT: Ghidra 12.1 requires, at minimum, JDK 21 to run."
GHIDRA_JDK_MIN_MAJOR="21"
GHIDRA_JDK_URL="https://adoptium.net/temurin/releases/?version=21"

# ---------------------------------------------------------------------------
# Alvo de análise — Sublime Text build 4215.
#   * O tarball NÃO é mais versionado no git (era 22 MB no repo): o setup.py o
#     baixa SOB DEMANDA da URL oficial e valida o SHA-256 ANTES de extrair.
#   * Fail-closed: SHA-256 divergente = erro fatal (nada é extraído/sobrescrito).
#   * Idempotente/offline: se o arquivo já estiver em bin/ com o SHA correto,
#     NENHUM download é tentado.
# ---------------------------------------------------------------------------
SUBLIME_BUILD="4215"
SUBLIME_TARBALL="bin/sublime_text_build_4215_x64.tar.xz"
SUBLIME_TARBALL_URL="https://download.sublimetext.com/sublime_text_build_4215_x64.tar.xz"
SUBLIME_TARBALL_SHA256="c153f418d3ab26b90ecce8c02a82e4e961025ed7a65f7e25060a5457d43e88d9"
SUBLIME_TARBALL_SIZE_BYTES="22300732"   # ~22 MiB (informativo; também checa o download)
SUBLIME_DEB="bin/sublime-text_build-4215_amd64.deb"
# Caminho do ELF dentro de target/ após extração (relativo à raiz do repo).
SUBLIME_TARGET_BIN="target/sublime_text/sublime_text"

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Rizin — provider de análise nativa alternativo ao Ghidra (execução mais leve).
#   * O REA procura `rizin` no PATH, ou usa `REA_RIZIN_COMMAND` quando setado.
#   * Build estático: não precisa de instalação de sistema, só extrair e apontar.
#   * Versão pinada: v0.9.1 (jun/2026) — Linux x86_64 estático.
# ---------------------------------------------------------------------------
RIZIN_VERSION="0.9.1"
RIZIN_STATIC_URL="https://github.com/rizinorg/rizin/releases/download/v${RIZIN_VERSION}/rizin-v${RIZIN_VERSION}-static-x86_64.tar.xz"
RIZIN_STATIC_SHA256="9102249a9f0b6319c5334a2e5cf8d9cc3f2035e1d3def027c41f6a90f647e8cf"
RIZIN_STATIC_SIZE_BYTES="137626404"
RIZIN_STATIC_FILENAME="rizin-v${RIZIN_VERSION}-static-x86_64.tar.xz"
RIZIN_EXTRACTED_DIRNAME="rizin-v${RIZIN_VERSION}"

# Requisitos de runtime / diretórios padrão.
# ---------------------------------------------------------------------------
NODE_MIN_MAJOR="20"
REA_TOOLS_DIR_DEFAULT="${HOME}/.local/share/sublime-rea-tools"

# ---------------------------------------------------------------------------
# Ferramental do próprio setup (setup.py) — pins auxiliares.
#   * RICH_VERSION: versão do `rich` instalada no venv local (setup/.venv) quando
#     o módulo não está disponível no python3 do sistema. Deve ser uma versão
#     existente no PyPI (https://pypi.org/project/rich/).
# ---------------------------------------------------------------------------
RICH_VERSION="13.9.4"
